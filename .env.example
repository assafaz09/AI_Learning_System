OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional per-task chat models (empty = use OPENAI_CHAT_MODEL)
# OPENAI_MODEL_TEACHER=gpt-4o
# OPENAI_MODEL_PROJECT_IDEAS=gpt-4o-mini
# OPENAI_MODEL_QUIZ_GENERATE=gpt-4o-mini
# OPENAI_MODEL_QUIZ_GRADE=gpt-4o-mini
# OPENAI_MODEL_PODCAST=gpt-4o-mini
# OPENAI_MODEL_GROUP_PEER_NOVICE=gpt-4o-mini
# OPENAI_MODEL_GROUP_PEER_INTERMEDIATE=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODE=local
WHISPER_LOCAL_MODEL=base
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# LangSmith (either LANGCHAIN_* or LANGSMITH_* — backend merges both)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=AI_learning_system
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangGraph Studio (local): from folder backend/ run: pip install -r requirements-dev.txt && langgraph dev
# Uses ../.env — keep OPENAI_API_KEY and LangSmith vars there; Qdrant should match QDRANT_URL if you use RAG graphs.
